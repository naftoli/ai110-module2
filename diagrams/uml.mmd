classDiagram
    class Task {
        +str title
        +int duration_minutes
        +int priority
        +str pet_name
        +bool is_required
        +bool completed
        +mark_complete()
    }

    class Pet {
        +str name
        +str species
        +List~Task~ tasks
        +add_task(task)
        +remove_task(task)
    }

    class Owner {
        +str name
        +int available_minutes
        +List~Pet~ pets
        +add_pet(pet)
        +get_all_tasks() List~Task~
    }

    class SkippedTask {
        +Task task
        +str reason
    }

    class DailyPlan {
        +List~Task~ scheduled
        +List~SkippedTask~ skipped
        +int total_minutes
        +missed_required() List~SkippedTask~
    }

    class Scheduler {
        +Owner owner
        +generate_plan() DailyPlan
        +explain(plan) str
    }

    Owner "1" --> "*" Pet : has
    Pet "1" --> "*" Task : has
    Scheduler "1" --> "1" Owner : plans for
    Scheduler ..> DailyPlan : creates
    DailyPlan "1" o-- "*" Task : includes
    DailyPlan "1" o-- "*" SkippedTask : skips
    SkippedTask "1" --> "1" Task : refers to
